{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product available in the AgriConnect store",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string" },
        "nameEnglish": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "rating": { "type": "number" },
        "discountPercent": { "type": "number" },
        "discountStart": { "type": "string" },
        "discountEnd": { "type": "string" }
      },
      "required": ["id", "name", "nameEnglish", "category", "price", "unit", "image", "description", "rating"]
    },
    "Seller": {
      "title": "Seller",
      "description": "Registered seller profile in the AgriConnect marketplace",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "ownerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "cnic": { "type": "string" },
        "shopName": { "type": "string" },
        "businessType": { "type": "string" },
        "city": { "type": "string" },
        "area": { "type": "string" },
        "address": { "type": "string" },
        "landmark": { "type": "string" },
        "products": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deliveryRange": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      },
      "required": ["uid", "ownerName", "email", "shopName"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order record",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "orderDate": { "type": "string" },
        "customerInfo": { "type": "object" },
        "deliveryAddress": { "type": "object" },
        "products": { "type": "array", "items": { "type": "object" } },
        "orderSummary": { "type": "object" },
        "status": { "type": "string" }
      },
      "required": ["orderNumber", "customerInfo", "products", "orderSummary"]
    },
    "User": {
      "title": "User",
      "description": "A user of the application",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["uid", "email", "role"]
    },
    "Newsletter": {
      "title": "Newsletter",
      "description": "Newsletter subscriber email record",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "subscribedAt": { "type": "string", "format": "date-time" },
        "source": { "type": "string" }
      },
      "required": ["email", "subscribedAt", "source"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of products"
    },
    "/sellers/{sellerId}": {
      "schema": "Seller",
      "description": "Collection of registered sellers"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of orders"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of users"
    },
    "/newsletter/{newsletterId}": {
      "schema": "Newsletter",
      "description": "Collection of newsletter subscribers"
    }
  }
}
